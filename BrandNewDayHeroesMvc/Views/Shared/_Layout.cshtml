<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Armario de Trajes</title>

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Inter:wght@400;600;700&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Estilos personalizados -->
    @{
        var cssFisico = Server.MapPath("~/Content/Site.css");
        var cssVersion = System.IO.File.Exists(cssFisico) ? System.IO.File.GetLastWriteTimeUtc(cssFisico).Ticks.ToString() : "1";
    }
    <link href="@Url.Content("~/Content/Site.css")?v=@cssVersion" rel="stylesheet" />
</head>
<body>
    @{
        var controlador = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
        Func<string, string> activo = c => string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? " active" : "";
    }

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark site-nav sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <span class="bolt">&#128375;&#65039;</span>Armario de Trajes
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link@(activo("Home"))" href="@Url.Action("Index", "Home")">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(activo("Heroes"))" href="@Url.Action("Index", "Heroes")">Héroes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link@(activo("Trajes"))" href="@Url.Action("Index", "Trajes")">Trajes</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <main class="container page pt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        &copy; 2026 Remigio Aguirre &middot; Armario de Trajes de Héroes
    </footer>

    <!-- Scripts principales -->
    <script src="~/Scripts/bootstrap.bundle.min.js">
    </script>
    @Scripts.Render("~/bundles/jquery")

    <!-- Renderiza la sección Scripts de cada vista -->
    @RenderSection("Scripts", required: false)
</body>
</html>
