@model BrandNewDayHeroesMvc.Models.Heroe

@{
    ViewBag.Title = "Detalles del héroe";
}

<div class="page-header">
    <div>
        <h2>Detalles del héroe</h2>
        <p class="subtitle">Ficha del defensor</p>
    </div>
</div>

<div class="panel-card panel-narrow">
    <div class="panel-head">@Html.DisplayFor(model => model.Alias)</div>
    <div class="panel-body">
        <dl class="detail-list">
            <div class="detail-row">
                <dt>Nombre del héroe</dt>
                <dd>@Html.DisplayFor(model => model.NombreHeroe)</dd>
            </div>
            <div class="detail-row">
                <dt>Alias</dt>
                <dd>@Html.DisplayFor(model => model.Alias)</dd>
            </div>
        </dl>

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-gold" href="@Url.Action("Edit", new { id = Model.HeroeId })">Editar</a>
            <a class="btn btn-ghost" href="@Url.Action("Index")">Volver a la lista</a>
        </div>
    </div>
</div>
