@model BrandNewDayHeroesMvc.Models.Heroe

@{
    ViewBag.Title = "Eliminar héroe";
}

<div class="page-header">
    <div>
        <h2>Eliminar héroe</h2>
        <p class="subtitle">Esta acción no se puede deshacer</p>
    </div>
</div>

<div class="panel-card panel-narrow">
    <div class="panel-head">Confirmar eliminación</div>
    <div class="panel-body">
        <div class="warning-box">
            <span class="icon">&#9888;&#65039;</span>
            <span>¿Seguro que deseas eliminar este héroe?</span>
        </div>

        <dl class="detail-list">
            <div class="detail-row">
                <dt>Nombre del héroe</dt>
                <dd>@Html.DisplayFor(model => model.NombreHeroe)</dd>
            </div>
            <div class="detail-row">
                <dt>Alias</dt>
                <dd>@Html.DisplayFor(model => model.Alias)</dd>
            </div>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-hero">Sí, eliminar</button>
                <a class="btn btn-ghost" href="@Url.Action("Index")">Cancelar</a>
            </div>
        }
    </div>
</div>
